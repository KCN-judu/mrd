{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MRD final verification manifest",
  "description": "Contract for results/final-manifest.json. A manifest records only evidence that was executed, unavailable with a probe, or explicitly deferred; it has no pending-success state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_state",
    "git_commit",
    "generated_at_utc",
    "environment",
    "campaigns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_state": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "architecture",
        "rustc_version",
        "cargo_version"
      ],
      "properties": {
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "rustc_version": {
          "type": "string",
          "minLength": 1
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "logical_cpu_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_status",
        "duration_seconds"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_status": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_count",
        "component_count",
        "input_model"
      ],
      "properties": {
        "input_count": {
          "type": "integer",
          "minimum": 0
        },
        "component_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unsupported_input_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "disagreement_count",
        "solver_error_count"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "disagreement_count": {
          "type": "integer",
          "const": 0
        },
        "solver_error_count": {
          "type": "integer",
          "const": 0
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "disposition",
        "claim_boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "external",
            "resource",
            "performance",
            "complexity",
            "release-audit"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "executed",
            "unavailable",
            "deferred"
          ]
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "population": {
          "$ref": "#/$defs/population"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "availability_probe": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1
        },
        "deferred_debt": {
          "type": "string",
          "minLength": 1
        },
        "deferred_reason": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "omitted_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "executed"
              }
            }
          },
          "then": {
            "required": [
              "completed_at_utc",
              "commands",
              "artifacts",
              "population",
              "outcome"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "required": [
              "availability_probe",
              "unavailable_reason",
              "omitted_claims",
              "next_action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "deferred"
              }
            }
          },
          "then": {
            "required": [
              "deferred_debt",
              "deferred_reason",
              "omitted_claims",
              "next_action"
            ]
          }
        }
      ]
    }
  }
}
